# Webhook para notificar en Discord
DISCORD_WEBHOOK_URL=url

# Canal donde permite invocar comandos
ALLOWED_COMMAND_CHANNEL=id

# SQLite
DB_PATH=data/thunderteam.db

# Turso
TURSO_DATABASE_URL=url
TURSO_AUTH_TOKEN=token
