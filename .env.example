# Slack
SLACK_BOT_TOKEN=token
SLACK_APP_TOKEN=token

# ID del equipo a vigilar
TEAM_ID=id

# Canal(es) que escucha, separado por comas
SOURCE_CHANNEL_IDS=id

# Canal(es) donde avisa, separado por comas
